// Copy to wifi_secrets.h (git-ignored) and fill in your Wi-Fi details.
#pragma once

#define WIFI_SSID "your-ssid"                  // Primary Mobile Hotspot SSID
#define WIFI_PASSWORD "your-password"                // Primary Hotspot Password
#define WIFI_FALLBACK_SSID "your-ssid"// Home Wi-Fi SSID
#define WIFI_FALLBACK_PASSWORD "your-password"       // Home Wi-Fi Password
#define WIFI_ALT_SSID "your-ssid"               // Secondary Hotspot SSID
#define WIFI_ALT_PASSWORD "your-password"            // Secondary Hotspot Password

// Device keys: the backend only accepts a speaker that sends the key for its MAC address.
// One {"MAC", "key"} pair per board; the firmware picks the entry for the MAC it runs as.
// Get a key as a platform admin from GET /api/v1/hardware/speakers/{id}/device-key, or run
//   python backend/scripts/speaker_device_key.py <MAC>
// with the backend's SPEAKER_KEY_SECRET (or JWT_SECRET_KEY). Keep these keys private.
#define SPEAKER_DEVICE_KEYS \
  {"D4:F3:2D:22:2A:CB", "paste-the-key-for-this-mac"}, \
  {"AA:BB:CC:DD:EE:FF", "paste-the-key-for-the-second-board"}
