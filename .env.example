# =============================================================
# EchoSphere Environment Configuration Template
# Copy this file to .env and fill in your local or deployment values.
# DO NOT commit the actual .env file to version control.
# =============================================================

# Frontend API Configuration
ECHOSPHERE_API_URL=http://localhost:8000/api/v1

# Backend & Hardware Discovery Configuration
ECHOSPHERE_SERVER=http://localhost:8000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./backend/echosphere.db
JWT_SECRET_KEY=change_this_to_a_secure_random_key_for_production
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
MQTT_HOST=localhost
MQTT_PORT=1883
