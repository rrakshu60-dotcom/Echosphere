# =============================================================
# EchoSphere Backend Environment Configuration Template
# Copy this file to backend/.env and fill in your values.
# DO NOT commit the actual .env file to version control.
# =============================================================

ENVIRONMENT=dev
DATABASE_URL=sqlite:///./echosphere.db
JWT_SECRET_KEY=change_this_to_a_secure_random_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
KOKORO_LANG=a
# Dedicated Kokoro-82M AI Worker URL (e.g., https://your-username-echosphere-kokoro-tts.hf.space)
KOKORO_API_URL=
# Optional Hugging Face Token (only needed if your Space is Private)
HF_TOKEN=
MQTT_HOST=localhost
MQTT_PORT=1883
